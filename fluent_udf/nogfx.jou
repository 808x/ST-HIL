; Fluent 2D journal: 500-step HIL loop without graphics export.
; The UDF still writes auto_frame.jou each iteration, but it is not read here
; because /display/save-picture is not functional with the null driver.
; Run: QT_QPA_PLATFORM=offscreen fluent 2d -t4 -driver null -i animate_hil_nogfx.jou
/file/set-tui-version "26.1"
chdir /home/nulltype/Projects/ST-HIL/st-hil_260803-adaptive/fluent_udf

file/read-case /home/nulltype/Projects/ST-HIL/st-hil_260803-adaptive/fluent_udf/elbow_hil_ready.cas.h5
/define/user-defined/compiled-functions/load /home/nulltype/Projects/ST-HIL/st-hil_260803-adaptive/fluent_udf/libudf

/define/user-defined/function-hooks/adjust
fpga_feedback_loop::libudf
""

/define/user-defined/function-hooks/execute-at-end
write_adaptive_frame::libudf
""

define/models/unsteady-1st-order? yes
solve/set/transient-controls/time-step-size 0.01
solve/set/transient-controls/number-of-time-steps 1

solve/initialize/hyb-initialization

